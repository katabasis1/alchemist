## SettlerConfig — вид и анимация станции Отстойника (S4.2, STATIONS §1.2): где носик колбы и горло Приёмника, где
## колба держит носик при сливе, как быстро встаёт в позу и возвращается, ритм «буль» и сила волн. Правила слива
## (скорость, хвост струи, чистый срез, время отстаивания) — в EconomyConfig, здесь только то, что видит и слышит игрок.
## Один .tres на форму колбы (data/settler/settler_round.tres — круглая колба prop_flask_round).
## Сигналы: нет. Зависимости: нет.
class_name SettlerConfig
extends Resource

@export_group("Колба")
## Носик — нижний край отверстия горла, когда колба наклонена к Приёмнику, px холста текстуры колбы: отсюда
## выходит струя.
@export var mouth_px: Vector2 = Vector2(232.0, 30.0)
## Где носик, пока колба льёт: смещение от середины горла Приёмника, px станции (минус по y — выше горла). Колба
## поворачивается вокруг носика, поэтому струя всё время падает в горло, как бы колба ни клонилась.
@export var spout_offset: Vector2 = Vector2(-18.0, -50.0)
## За сколько секунд колба встаёт в позу слива, когда игрок зажал её. Струя и слив — с момента, когда встала:
## отпустил раньше — не льётся ни капли.
@export_range(0.01, 1.0) var lift_sec: float = 0.14
## За сколько секунд колба возвращается на прилавок после слива (хвост струи уже дотёк).
@export var return_sec: float = 0.28
## Как плотно наклон догоняет угол от уровня (1/с): уровень падает — колба клонится дальше.
@export var tilt_sharpness: float = 14.0

@export_group("Струя и Приёмник")
## Середина отверстия Приёмника, px холста его текстуры: над ней колба держит носик.
@export var receiver_mouth_px: Vector2 = Vector2(160.0, 48.0)
## Струя входит в Приёмник на столько пикселей ниже поверхности: конец струи не висит над жидкостью.
@export var stream_dip_px: float = 6.0
## Пауза между «буль» на полной скорости слива, с. На медленной — длиннее, в такт скорости.
@export var glug_sec_full: float = 0.24
## Волна в Приёмнике на каждый «буль», px холста.
@export var receiver_bump_px: float = 3.0

@export_group("Отклик")
## Колба «булькает», если зажать её во время отстаивания: волна, px холста.
@export var bubble_bump_px: float = 6.0
## Волна при приёме смеси, px холста.
@export var receive_bump_px: float = 9.0
