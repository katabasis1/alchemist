## SettlerConfig — вид и анимация станции Отстойника (S4.2, STATIONS §1.2): где носик колбы, как высоко она
## поднимается при сливе, как быстро наклоняется и возвращается, ритм «буль» и сила волн. Правила слива (скорость,
## хвост струи, чистый срез, время отстаивания) — в EconomyConfig, здесь только то, что видит и слышит игрок.
## Один .tres на форму колбы (data/settler/settler_round.tres — круглая колба prop_flask_round).
## Сигналы: нет. Зависимости: нет.
class_name SettlerConfig
extends Resource

@export_group("Колба")
## Носик — край венчика со стороны слива, px холста текстуры колбы: отсюда выходит струя.
@export var mouth_px: Vector2 = Vector2(252.0, 24.0)
## На сколько пикселей станции колба поднимается над прилавком, пока льёт.
@export var pour_lift: float = 170.0
## За сколько секунд колба поднимается и наклоняется, когда игрок зажал её.
@export var lift_sec: float = 0.14
## За сколько секунд колба возвращается на прилавок после слива (хвост струи уже дотёк).
@export var return_sec: float = 0.28
## Как плотно наклон догоняет угол от уровня (1/с): уровень падает — колба клонится дальше.
@export var tilt_sharpness: float = 14.0

@export_group("Струя и Приёмник")
## Струя входит в Приёмник на столько пикселей ниже поверхности: конец струи не висит над жидкостью.
@export var stream_dip_px: float = 6.0
## Пауза между «буль» на полной скорости слива, с. На медленной — длиннее, в такт скорости.
@export var glug_sec_full: float = 0.24
## Волна в Приёмнике на каждый «буль», px холста.
@export var receiver_bump_px: float = 3.0

@export_group("Отклик")
## Колба «булькает», если зажать её во время отстаивания: волна, px холста.
@export var bubble_bump_px: float = 6.0
## Волна при приёме смеси, px холста.
@export var receive_bump_px: float = 9.0
