[gd_scene format=3]

[ext_resource type="Script" path="res://components/comp.gd" id="1_comp"]
[ext_resource type="Texture2D" path="res://assets/icons/icon_a.png" id="2_icon"]
[ext_resource type="Texture2D" path="res://assets/icons/missing.png" id="3_miss"]
[ext_resource type="Texture2D" path="res://assets/icons/icon_a.png" id="2_icon"]
[ext_resource type="PackedScene" path="res://assets/icons/icon_a.png" id="4_mis"]
[ext_resource type="Script" path="res://scripts/ctrl.gd" id="6_ctrl"]
[ext_resource type="Texture2D" uid="uid://bogus123" path="res://assets/icons/icon_a.png" id="5_uid"]

[sub_resource type="ShaderMaterial" id="Mat_a"]
next_pass = SubResource("Mat_b")

[sub_resource type="ShaderMaterial" id="Mat_b"]

[node name="Main" type="Node2D" node_paths=PackedStringArray("not_exported")]
script = ExtResource("1_comp")
not_exported = NodePath("Icon")
texture_ref = ExtResource("zz")

[node name="Icon" type="Sprite2D" parent="."]
texture = ExtResource("2_icon")

[node name="Icon" type="Sprite2D" parent="."]

[node name="Orphan" type="Node" parent="Nowhere"]

[node name="NoType" parent="."]

[node name="BadInst" parent="." instance=ExtResource("2_icon")]

[node name="Holder" type="Node" parent="." node_paths=PackedStringArray("exported_one")]
script = ExtResource("1_comp")
exported_one = NodePath("../Missing")
other = NodePath("../../Outside")

[node name="Custom" type="MyComp" parent="."]

[node name="Typo" type="Sprite3DD" parent="."]

[node name="Label" type="Label" parent="."]
text = "MISSING_KEY"

[node name="Label2" type="Label" parent="."]
text = "Привет, мир"

[node name="WrongHost" type="Sprite2D" parent="."]
