[gd_resource type="Resource" script_class="RecipeData" format=3]

[ext_resource type="Script" path="res://data/recipes/recipe_data.gd" id="1_recipe_data"]

[resource]
script = ExtResource("1_recipe_data")
id = &"sun_elixir"
name_key = &"RECIPE_SUN_ELIXIR_NAME"
desc_key = &"RECIPE_SUN_ELIXIR_DESC"
