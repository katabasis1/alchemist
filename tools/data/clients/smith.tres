orders = Array[ExtResource("2_order_template")]([ExtResource("3_warming_ointment_s1_p1"), ExtResource("4_warming_ointment_s1_p2"), ExtResource("5_warming_ointment_s2_p2"), ExtResource("6_smith_flux_s1_p2"), ExtResource("7_smith_flux_s2_p2"), ExtResource("8_rust_remover_s1_p2"), ExtResource("9_rust_remover_s2_p3"), ExtResource("10_armor_polish_s1_p2"), ExtResource("11_armor_polish_s1_p3")])
pay_multiplier = 1.0
visits_per_day = 0
