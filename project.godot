; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Лавка алхимика"
config/name_localized={
"en": "The Alchemist's Shop",
"ru": "Лавка алхимика"
}
config/description="Уютный симулятор алхимической лавки"
config/version="0.2.3"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.258824, 0.133333, 0.054902, 1)

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

EventBus="*res://autoload/event_bus/event_bus.tscn"
Platform="*res://autoload/platform/platform.tscn"
GameState="*res://autoload/game_state/game_state.tscn"
SaveService="*res://autoload/save_service/save_service.tscn"
AudioDirector="*res://autoload/audio_director/audio_director.tscn"
SceneRouter="*res://autoload/scene_router/scene_router.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/main_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.ru.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.258824, 0.133333, 0.054902, 1)
